{
  "schemaVersion": 1,
  "id": "animeunity-browse",
  "familyID": "animeunity-browse",
  "name": "AnimeUnity",
  "version": "0.2.14",
  "minimumAppVersion": "2.0.36",
  "contentType": "video",
  "language": "it",
  "contentRating": "unknown",
  "releaseTrack": "beta",
  "status": "active",
  "attribution": {
    "author": "Community candidate (unverified)",
    "website": "https://www.animeunity.so"
  },
  "authorization": {
    "basis": "personal",
    "note": "Candidato di test non verificato: lo stato dei diritti dei contenuti non è stato accertato. Usare solo contenuti a cui si ha diritto di accesso; nessun diritto di distribuzione è fornito. Non pubblicare senza verifica del maintainer.",
    "evidenceURL": "https://www.animeunity.so/"
  },
  "allowedHosts": [
    "www.animeunity.so",
    "vixcloud.co",
    "*.vix-content.net",
    "img.animeunity.so",
    "img.animeworld.ac",
    "*.anilist.co",
    "*.myanimelist.net",
    "static.nexilia.it",
    "image.tmdb.org",
    "i.ibb.co",
    "www.forbiddenlol.cloud",
    "www.animeclick.it"
  ],
  "publicSourceSession": {
    "bootstrapURL": "https://www.animeunity.so/",
    "csrfSelector": "meta[name=csrf-token]",
    "cookieNames": [
      "animeunity_session"
    ],
    "lifetimeSeconds": 120
  },
  "capabilities": [
    "discovery",
    "search",
    "details",
    "episodes",
    "streams"
  ],
  "limits": {
    "timeoutMilliseconds": 15000,
    "maxConcurrentRequests": 2,
    "maxResponseBytes": 4194304
  },
  "operations": {
    "discovery": {
      "sections": [
        {
          "id": "latest",
          "title": "Ultimi aggiornamenti",
          "semantic": "recent",
          "request": {
            "method": "GET",
            "urlTemplate": "https://www.animeunity.so/?page={page}",
            "headers": {
              "Accept": "text/html",
              "Referer": "https://www.animeunity.so/"
            }
          },
          "response": {
            "format": "html"
          },
          "pagination": {
            "type": "pageParam",
            "start": 1,
            "maxPages": 2
          },
          "items": {
            "collection": "div.latest-anime-container",
            "fields": {
              "sourceID": {
                "selector": "a[href*=\"/anime/\"]",
                "part": "attr",
                "attr": "href",
                "transforms": [
                  {
                    "op": "removePrefix",
                    "value": "https://www.animeunity.so/anime/"
                  },
                  {
                    "op": "firstInteger"
                  }
                ]
              },
              "title": {
                "selector": "strong.latest-anime-title",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  }
                ]
              },
              "posterURL": {
                "selector": "img",
                "part": "attr",
                "attr": "src"
              }
            }
          }
        },
        {
          "id": "archive",
          "title": "Archivio",
          "semantic": "all",
          "request": {
            "method": "POST",
            "urlTemplate": "https://www.animeunity.so/archivio/get-animes?limit={limit}",
            "headers": {
              "Accept": "application/json",
              "X-Requested-With": "XMLHttpRequest",
              "Origin": "https://www.animeunity.so",
              "Referer": "https://www.animeunity.so/archivio"
            },
            "body": "{\"title\":\"\",\"type\":false,\"year\":false,\"order\":\"popolarita\",\"status\":false,\"genres\":false,\"offset\":\"{offset}\",\"dubbed\":false,\"season\":false}"
          },
          "response": {
            "format": "json"
          },
          "pagination": {
            "type": "offset",
            "start": 1,
            "pageSize": 30,
            "firstItem": 0,
            "maxPages": 25
          },
          "items": {
            "collection": "records[*]",
            "fields": {
              "sourceID": {
                "path": "id"
              },
              "title": {
                "path": "title_eng",
                "fallbacks": [
                  {
                    "path": "title"
                  }
                ]
              },
              "posterURL": {
                "path": "imageurl"
              }
            }
          }
        }
      ]
    },
    "search": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.animeunity.so/archivio?title={query}",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://www.animeunity.so/"
        }
      },
      "response": {
        "format": "html-attr-json",
        "selector": "archivio",
        "attribute": "records"
      },
      "items": {
        "collection": "[*]",
        "fields": {
          "sourceID": {
            "path": "id"
          },
          "title": {
            "path": "title_eng",
            "fallbacks": [
              {
                "path": "title"
              }
            ]
          },
          "posterURL": {
            "path": "imageurl"
          }
        }
      }
    },
    "details": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.animeunity.so/anime/{titleID}-0",
        "headers": {
          "Accept": "text/html",
          "Referer": "https://www.animeunity.so/"
        }
      },
      "response": {
        "format": "html-attr-json",
        "selector": "video-player",
        "attribute": "anime"
      },
      "extract": {
        "title": {
          "path": "title_eng",
          "fallbacks": [
            {
              "path": "title"
            },
            {
              "path": "title_it"
            }
          ]
        },
        "synopsis": {
          "path": "plot"
        },
        "posterURL": {
          "path": "imageurl"
        },
        "year": {
          "path": "date"
        },
        "availableVariants": {
          "collection": "dub[*]",
          "transforms": [
            {
              "op": "replaceFirst",
              "find": "1",
              "with": "dub"
            },
            {
              "op": "replaceFirst",
              "find": "0",
              "with": "sub"
            }
          ]
        }
      }
    },
    "episodes": {
      "request": {
        "method": "GET",
        "urlTemplate": "https://www.animeunity.so/info_api/{titleID}/1?start_range=1&end_range=120",
        "headers": {
          "Accept": "application/json",
          "Referer": "https://www.animeunity.so/"
        }
      },
      "response": {
        "format": "json"
      },
      "extract": {
        "collection": "episodes[*]",
        "fields": {
          "episodeID": {
            "path": "id"
          },
          "title": {
            "path": "file_name",
            "transforms": [
              {
                "op": "removeBracketedSegments"
              },
              {
                "op": "trim"
              }
            ]
          },
          "episodeNumber": {
            "path": "number",
            "transforms": [
              {
                "op": "firstInteger"
              }
            ]
          }
        }
      }
    },
    "streams": {
      "variants": [
        "sub",
        "dub"
      ],
      "playbackHeaders": {
        "Referer": "https://vixcloud.co/",
        "Origin": "https://vixcloud.co"
      },
      "finalMediaPolicy": "public-https",
      "steps": [
        {
          "request": {
            "method": "GET",
            "urlTemplate": "https://www.animeunity.so/embed-url/{episodeID}",
            "headers": {
              "Referer": "https://www.animeunity.so/"
            }
          },
          "response": {
            "format": "html"
          },
          "extract": {
            "context": {
              "embed": {
                "kind": "url",
                "selector": "body",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  }
                ]
              }
            }
          }
        },
        {
          "request": {
            "method": "GET",
            "follow": "embed",
            "headers": {
              "Referer": "https://www.animeunity.so/"
            }
          },
          "response": {
            "format": "html"
          },
          "extract": {
            "collection": {
              "selector": "script:containsData(window.downloadUrl)",
              "where": [
                {
                  "field": "qualityLabel",
                  "containsPlaceholder": "variant"
                }
              ]
            },
            "fields": {
              "url": {
                "selector": "script:containsData(window.downloadUrl)",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  },
                  {
                    "op": "removePrefix",
                    "value": "window.downloadUrl = '"
                  },
                  {
                    "op": "removeSuffix",
                    "value": "'"
                  }
                ]
              },
              "qualityLabel": {
                "selector": "script:containsData(window.downloadUrl)",
                "part": "text",
                "transforms": [
                  {
                    "op": "trim"
                  },
                  {
                    "op": "removePrefix",
                    "value": "window.downloadUrl = '"
                  },
                  {
                    "op": "replaceFirst",
                    "find": "SUB_ITA",
                    "with": "SUB"
                  },
                  {
                    "op": "replaceFirst",
                    "find": "ITA",
                    "with": "DUB"
                  }
                ]
              },
              "mediaTypeHint": {
                "literal": "mp4"
              }
            }
          }
        }
      ]
    }
  },
  "releaseNotes": "0.2.14: streams fully variant-gated again (script read of window.downloadUrl + SUB_ITA/ITA marker chain + {variant} where-filter): a Sub request can never be served the Italian audio and vice versa. The 0.2.12/0.2.13 HLS route played but could not separate the two audios (the app resolves sub and dub for every title), which is why (ITA) titles still played Italian under Sub. Script-text extraction pending on-device verification.",
  "requiredEngineFeatures": [
    "public-source-session-v1",
    "checked-pagination-v1"
  ]
}
